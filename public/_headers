/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/og/*
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/docs/*.md
  Link: <https://hextaui.com/docs/:splat>; rel="canonical"

/docs.md
  Link: <https://hextaui.com/docs>; rel="canonical"

/index.md
  Link: <https://hextaui.com/>; rel="canonical"

/pricing.md
  Link: <https://hextaui.com/pricing>; rel="canonical"

/blog.md
  Link: <https://hextaui.com/blog>; rel="canonical"

/blog/*.md
  Link: <https://hextaui.com/blog/:splat>; rel="canonical"

/blog/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/blog/:slug/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/404.md
  X-Robots-Tag: noindex

/*.txt
  X-Robots-Tag: noindex

/r/*
  X-Robots-Tag: noindex

/mcp/*
  X-Robots-Tag: noindex

/docs/search.json
  X-Robots-Tag: noindex

/docs/source/*
  X-Robots-Tag: noindex

/preview/*
  X-Robots-Tag: noindex, nofollow, indexifembedded

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/
  Vary: Accept
  Link: </index.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain", </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc"; type="application/vnd.oai.openapi+json", </docs/api>; rel="service-doc"; type="text/html", </.well-known/ard.json>; rel="ard"; type="application/json", </pricing.md>; rel="alternate"; type="text/markdown"; title="Pricing"

/openapi.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/server.json
  Access-Control-Allow-Origin: *

/.well-known/*
  Access-Control-Allow-Origin: *

/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Link: </.well-known/api-catalog>; rel="api-catalog"

/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8

/.well-known/mcp.json
  Content-Type: application/json; charset=utf-8

/.well-known/ai-catalog.json
  Content-Type: application/json; charset=utf-8

/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8

/.well-known/ard.json
  Content-Type: application/json; charset=utf-8

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8

/docs/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/blocks/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

{
  "name": "hextaui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm pro:build && next dev",
    "dev:api": "wrangler pages dev",
    "build": "pnpm pro:build && pnpm registry:build && next build && node --experimental-strip-types --no-warnings scripts/flatten-markdown.ts && node --experimental-strip-types --no-warnings scripts/localize-html.ts && node --experimental-strip-types --no-warnings scripts/write-routes.ts && node --experimental-strip-types --no-warnings scripts/check-pro-leak.ts && node --experimental-strip-types --no-warnings scripts/check-html-size.ts && node --experimental-strip-types --no-warnings scripts/check-structured-data.ts",
    "start": "next start",
    "registry:sync": "node scripts/sync-registry.mjs",
    "registry:build": "pnpm registry:sync && shadcn build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "pnpm pro:build && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hextaui --local",
    "db:migrate:remote": "wrangler d1 migrations apply hextaui --remote",
    "email": "node --env-file-if-exists=.dev.vars --experimental-strip-types --no-warnings scripts/email.ts",
    "i18n:sync": "node --experimental-strip-types --no-warnings scripts/i18n-sync.ts",
    "shadcn:snapshot": "node --experimental-strip-types --no-warnings scripts/shadcn-snapshot.ts",
    "pro:build": "node --experimental-strip-types --no-warnings scripts/build-pro.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@modelcontextprotocol/server": "^2.3.1",
    "@next/third-parties": "16.4.0",
    "@shadcn/react": "0.3.1",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-table": "^9.2.6",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dodopayments": "2.54.0",
    "drizzle-orm": "0.45.3",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.3",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.133",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ai": "7.0.130",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "streamdown": "2.7.0",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "wrangler": "4.148.0"
  }
}
